{
	"schemaVersion": 1,
	"id": "afk-notifier",
	"version": "${version}",
	"name": "AFK Farm Telegram Notifier",
	"description": "Клиентский мод: следит за состоянием игрока на AFK-ферме и шлёт уведомления в Telegram.",
	"license": "MIT",
	"icon": "assets/afk-notifier/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ru.afknotifier.AfkNotifierClient"
		],
		"modmenu": [
			"ru.afknotifier.gui.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "afk-notifier.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
